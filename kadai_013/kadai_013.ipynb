      "source": [
        "# 消費税を加えた計算結果を返す関数を定義\n",
        "def add_tax(price, tax_rate):\n",
        "    # 税込み金額を計算（price：商品金額、tax_rate：税率）\n",
        "    total_price = price + (price * tax_rate / 100)\n",
        "    return total_price  # 算出結果を戻り値として返す\n",
        "\n",
        "# 第1引数に110（商品金額）、第2引数に10（消費税率）を渡して関数を呼び出す\n",
        "result = add_tax(110, 10)\n",
        "\n",
        "# 結果を表示\n",
        "print(result)\n"
      ],
