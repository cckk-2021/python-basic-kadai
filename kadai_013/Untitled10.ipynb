        "def add_tax(price, tax_rate):\n",
        "    total_price = price + (price * tax_rate / 100)

        "    #価格に消費税を加えた金額を返す関数\n",
        "    return total_price\n",
        "total = add_tax(110, 10)\n",
        "\n",
        "print(total)"
